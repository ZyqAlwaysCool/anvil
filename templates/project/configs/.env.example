APP_NAME={{.ProjectName}}
APP_ENV=local

HTTP_PORT=8080
HTTP_GIN_MODE=debug

LOG_LEVEL=info
LOG_FORMAT=text
LOG_DIR=var/log/{{.ProjectName}}
LOG_FILE_PREFIX=app
LOG_STDOUT=true
LOG_RETENTION_DAYS=7

# 默认保守关闭；本地仅启动 HTTP 时可保持 false。
REDIS_ENABLED=false
REDIS_MODE=single
REDIS_ADDRS=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=5s

MYSQL_ENABLED=false
MYSQL_DSN=
MYSQL_TIMEOUT=5s

SQLITE_ENABLED=false
SQLITE_DSN=
SQLITE_TIMEOUT=5s

MONGO_ENABLED=false
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE={{.ProjectName}}
MONGO_TIMEOUT=10s

# 启用任务系统时需同时打开 TASK_ENABLED、REDIS_ENABLED、MONGO_ENABLED。
TASK_ENABLED=false
TASK_STREAM_KEY={{.ProjectName}}:tasks:stream
TASK_CONSUMER_GROUP={{.ProjectName}}-task-workers
TASK_CONSUMER_NAME={{.ProjectName}}-worker
TASK_READ_BLOCK=3s
TASK_MAX_LEN=10000
TASK_WORKER_CONCURRENCY=2
TASK_RETRY_JOBS=true
TASK_MAX_TRIES=3
TASK_JOB_TIMEOUT=3600s

LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60s

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXCLUDE_PATHS=/health,/api/v1/tasks/health

# CORS 默认白名单为空，不放开 *。
CORS_ALLOW_ORIGINS=
CORS_ALLOW_METHODS=
CORS_ALLOW_HEADERS=
CORS_MAX_AGE=600
